# Local-only Edge Function secrets. Copy to .env.local; it is gitignored.
# Never put live Stripe credentials in this file.
STRIPE_MODE=test
STRIPE_SECRET_API_KEY=sk_test_replace_with_your_rotated_test_key
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_test_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_replace_after_running_stripe_listen
SITE_URL=http://localhost:8091
# Set only when running local Edge functions with an explicit loopback SITE_URL.
ATELIX_LOCAL_EDGE=1

# Optional: payment notification emails stay disabled unless configured.
# RESEND_API_KEY=re_replace_me
# RESEND_FROM=Atelix Orders <onboarding@resend.dev>
