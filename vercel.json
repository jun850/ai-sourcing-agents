{
  "rewrites": [
    { "source": "/intools/dashboard", "destination": "/intools/dashboard.html" },
    { "source": "/categories", "destination": "/pages/categories.html" },
    {
      "source": "/categories/:l2",
      "destination": "/pages/category.html?l2=:l2"
    },
    {
      "source": "/categories/:l2/:l3",
      "destination": "/pages/category.html?l2=:l2&l3=:l3"
    },
    { "source": "/search", "destination": "/pages/search.html" },
    { "source": "/cart", "destination": "/pages/cart.html" },
    { "source": "/about", "destination": "/pages/about.html" },
    { "source": "/agentpoc", "destination": "/pages/agentpoc.html" },
    { "source": "/help-center", "destination": "/pages/help-center.html" },
    { "source": "/legal", "destination": "/pages/legal.html" },
    { "source": "/terms", "destination": "/pages/terms.html" },
    { "source": "/privacy", "destination": "/pages/privacy.html" },
    { "source": "/trust-safety", "destination": "/pages/trust-safety.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'self'; upgrade-insecure-requests; block-all-mixed-content" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/intools/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
