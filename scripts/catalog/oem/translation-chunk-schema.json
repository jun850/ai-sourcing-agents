{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "translations"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "translations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "en", "ja", "zh"],
        "properties": {
          "id": { "type": "string" },
          "en": { "$ref": "#/$defs/copy" },
          "ja": { "$ref": "#/$defs/copy" },
          "zh": { "$ref": "#/$defs/copy" }
        }
      }
    }
  },
  "$defs": {
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "supplierType", "businessOutline", "description", "sellingPoints"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "supplierType": { "type": ["string", "null"] },
        "businessOutline": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "sellingPoints": { "type": ["string", "null"] }
      }
    }
  }
}
