{
  "name": "atelix-ai-sourcing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node server/index.mjs\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "lint": "tsc --noEmit",
    "qa:agent-rfq": "node scripts/qa-agent-rfq.mjs",
    "qa:rfq-ops-chat": "node scripts/qa-rfq-ops-chat.mjs",
    "suppliers:import": "node --experimental-strip-types scripts/suppliers/import.ts",
    "suppliers:queue": "node scripts/suppliers/build-research-queue.mjs",
    "suppliers:clean-regional": "node scripts/suppliers/clean-regional-research.mjs",
    "suppliers:normalize-regional": "node scripts/suppliers/normalize-regional-research.mjs data/regional-research/raw_suppliers.cleaned.jsonl data/regional-research/normalized-v2",
    "suppliers:crawl-regional": "node scripts/suppliers/crawl-regional-research.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@supabase/supabase-js": "^2.112.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "imagetracerjs": "^1.2.6",
    "jpeg-js": "^0.4.4",
    "typescript": "^5.7.2",
    "vite": "^8.2.2"
  }
}
