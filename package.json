{
  "name": "marketplace",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "node scripts/local-server.js",
    "test": "npm run qa:static",
    "crawl:apparel-x-oem": "node scripts/crawl-apparel-x-oem.js",
    "catalog:crawl-only": "node scripts/catalog/crawl/cli.js",
    "catalog:oem-normalize": "node scripts/catalog/oem/cli.js",
    "catalog:build-manifest": "node scripts/catalog/publish/build-manifest.js",
    "catalog:prepare-oem": "node scripts/catalog/publish/prepare-oem-batches.js",
    "catalog:publish": "node scripts/catalog/publish/publisher.js",
    "qa:static": "node scripts/qa-static.js",
    "qa:browser": "node scripts/qa-browser.js",
    "qa:intools": "node scripts/qa-intools.js",
    "qa:regression": "npm run qa:static && npm run qa:browser && npm run qa:intools",
    "bundle:analytics": "esbuild js/analytics-entry.js --bundle --minify --outfile=js/analytics.bundle.js",
    "bundle:supabase": "esbuild js/supabase-entry.js --bundle --minify --outfile=js/supabase-client.bundle.js",
    "bundle:all": "npm run bundle:analytics && npm run bundle:supabase"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jun850/marketplace.git"
  },
