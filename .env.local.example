# Generated local Supabase client settings. Run `npm run supabase:local:setup`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_status_publishable_key

# Development-only Intools seam. Never use these values outside local Docker.
ATELIX_LOCAL_INTOOLS=1
ATELIX_LOCAL_SUPABASE_URL=http://127.0.0.1:54321
ATELIX_LOCAL_SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_status_publishable_key
ATELIX_LOCAL_ADMIN_EMAIL=admin@local.test
ATELIX_LOCAL_ADMIN_PROFILE_ID=replace_with_created_local_user_id
ATELIX_LOCAL_ADMIN_SUPABASE_PASSWORD=change-me-local-only
ATELIX_LOCAL_INTOOLS_COOKIE_SECRET=replace_with_a_random_32_character_secret

# The Vite app uses the local API; Stripe/OpenRouter/Resend remain disabled by
# default in local function development unless explicitly configured.
