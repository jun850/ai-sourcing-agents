  "bugs": {
    "url": "https://github.com/jun850/marketplace/issues"
  },
  "homepage": "https://github.com/jun850/marketplace#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "@vercel/analytics": "^2.0.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
